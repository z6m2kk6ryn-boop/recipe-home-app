  {
    "id": "recipe_1780464209528_0.6968858629678896",
    "title": "鶏むね肉と彩り野菜の香味だれ",
    "ingredients": [
      "鶏むね肉 1枚(300g)",
      "茄子 1本(130g)",
      "トマト 1個(100g)",
      "酒・醤油 各小さじ2",
